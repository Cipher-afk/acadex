[Unit]
Description=Acadex WhatsApp Baileys Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/acadex-whatsapp/whatsapp
EnvironmentFile=/opt/acadex-whatsapp/whatsapp/.env
ExecStart=/usr/bin/node /opt/acadex-whatsapp/whatsapp/src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
